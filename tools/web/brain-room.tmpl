    <script type="application/javascript">

    const gameCanvas = document.getElementById("canvas");
    let mouseEvent;
    document.addEventListener("mousemove", event => {
        mouseEvent = event;
    }, { passive: true });

    // The web runtime applies its own mouse scaling. Map the browser position
    // directly to the drawing buffer using the canvas's current bounds.
    function brainRoomMousePosition() {
        const bounds = gameCanvas.getBoundingClientRect();
        if (!mouseEvent || !bounds.width || !bounds.height)
            return { x: 0, y: 0 };
        return {
            x: Math.round((mouseEvent.clientX - bounds.left) * gameCanvas.width / bounds.width),
            y: Math.round((mouseEvent.clientY - bounds.top) * gameCanvas.height / bounds.height),
        };
    }

    globalThis.__canvas_resized = (self, ecw, ech) => {
        console.warn("TODO: panda3d canvas monitor", self, ecw, ech)
